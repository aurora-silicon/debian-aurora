#!/bin/bash
# Build and seal an image of "Aurora, based on Debian testing" for the native installer.
#
#   scripts/build-image PROFILE REPOSITORY [CHANNEL]
#
# PROFILE is debian-kde, debian-gnome or debian-minimal. REPOSITORY is the
# signed Aurora package repository the image installs from: an https URL, or
# a local directory (scripts/sign-repository.py output), served on loopback
# while the image is built. CHANNEL (testing, stable or edge) is the feed the
# installed system follows afterwards. The Debian base comes from the
# snapshot pinned in images/base.json.
#
# Follows alarm-aurora's scripts/build-image step for step; see
# docs/images.md for where Debian differs. Requires a disposable privileged
# native AArch64 builder, as the shared finalizer does.
set -euo pipefail
trap 'status=$?; echo "Aurora image failed ($status) at line $LINENO: $BASH_COMMAND" >&2; exit "$status"' ERR
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# An image serves every Mac, whichever one builds it.
export AURORA_DEVICE_TREE_COMPATIBLE=/nonexistent
profile=${1:?debian-kde, debian-gnome or debian-minimal required}
repository=${2:?signed Aurora package repository required}
channel=${3:-testing}
[[ $profile =~ ^debian-(kde|gnome|minimal)$ && $channel =~ ^(testing|stable|edge)$ ]]
[[ $(id -u) == 0 && $(uname -m) == aarch64 ]]
desktop=${profile#debian-}
# The key that signs the repository: the production key, or the local
# development key (scripts/dev-signing-key) for an image that is never published.
key=${AURORA_ARCHIVE_KEY:-$root/packages/aurora-archive-keyring/keys/aurora-debian-archive.asc}
[[ -s $key ]]
read -r suite mirror live_mirror keyring < <(python3 -c '
import json, sys
base = json.load(open(sys.argv[1]))
print(base["suite"], base["mirror"], base["live_mirror"], base["keyring"])' "$root/images/base.json")
components=$(python3 -c 'import json, sys; print(" ".join(json.load(open(sys.argv[1]))["components"]))' \
  "$root/images/base.json")

output=$root/out/$profile
[[ ! -e $output ]]
mkdir -p "$output"
image=$output/aurora.raw
size=6G
[[ $profile == debian-minimal ]] || size=16G
truncate -s "$size" "$image"
printf 'label: gpt\nsector-size: 4096\n\nstart=2048,size=131072,type=U\nsize=262144,type=BC13C2FF-59E6-4262-A352-B275FD6F7172\ntype=B921B045-1DF0-41C3-AF44-4C6F280D3FAE\n' | sfdisk --sector-size 4096 "$image"
loop='' server='' mountroot=$(mktemp -d)
cleanup() {
  local status=$? clean=1
  trap - EXIT
  [[ -z $server ]] || kill "$server" 2>/dev/null || true
  for path in dev proc sys run boot/efi boot ''; do
    if mountpoint -q "$mountroot${path:+/$path}"; then umount -R "$mountroot${path:+/$path}" || clean=0; fi
  done
  if (( clean )); then
    [[ -z $loop ]] || losetup -d "$loop"
    rmdir "$mountroot"
  else echo "Image mounts remain at $mountroot" >&2; status=1; fi
  exit "$status"
}
trap cleanup EXIT

# A local repository is served on loopback, so apt reaches it at the same URL
# outside the image (bootstrap) and inside it (package installation).
if [[ -d $repository ]]; then
  port=$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')
  python3 -m http.server --bind 127.0.0.1 --directory "$repository" "$port" >/dev/null 2>&1 &
  server=$!
  repository=http://127.0.0.1:$port
  for _ in $(seq 50); do curl -fsS "$repository/dists/aurora/InRelease" >/dev/null 2>&1 && break; sleep 0.1; done
fi
[[ $repository =~ ^https?:// ]]
curl -fsS "$repository/dists/aurora/InRelease" >/dev/null

loop=$(losetup --find --show --partscan --sector-size 4096 "$image")
udevadm settle
mkfs.vfat -F32 -n AURORA_EFI "${loop}p1"
mkfs.ext4 -F -L AURORA_BOOT "${loop}p2"
mkfs.btrfs -f -L AURORA_ROOT -s 4096 -n 16384 "${loop}p3"
mount "${loop}p3" "$mountroot"
btrfs subvolume create "$mountroot/root"
btrfs subvolume create "$mountroot/home"
umount "$mountroot"
mount -o subvol=root,compress=zstd:1 "${loop}p3" "$mountroot"

# The Debian base from the pinned snapshot, verified with Debian's archive keys.
mmdebstrap --mode=root --variant=important --architectures=arm64 --components="${components// /,}" \
  --keyring="$keyring" --aptopt='Acquire::Check-Valid-Until "false"' --aptopt='Acquire::Retries "5"' \
  --include=ca-certificates,curl,gpg,locales,sudo,systemd-sysv,systemd-resolved \
  "$suite" "$mountroot" "deb $mirror $suite $components"

mkdir -p "$mountroot"/{dev,proc,sys,run,boot}
mount "${loop}p2" "$mountroot/boot"
mkdir -p "$mountroot/boot/efi"
mount "${loop}p1" "$mountroot/boot/efi"
mount --rbind /dev "$mountroot/dev"
mount --make-rslave "$mountroot/dev"
mount -t proc proc "$mountroot/proc"
mount --rbind /sys "$mountroot/sys"
mount --make-rslave "$mountroot/sys"
mount -t tmpfs tmpfs "$mountroot/run"
rm -f "$mountroot/etc/resolv.conf"
cp -L /etc/resolv.conf "$mountroot/etc/resolv.conf"

# Aurora's repository, checked with its pinned key, ahead of Debian's through
# the pin aurora-archive-keyring installs (written here too, for the build).
install -d -m 0755 "$mountroot/etc/apt/keyrings" "$mountroot/etc/apt/preferences.d"
gpg --batch --dearmor < "$key" > "$mountroot/etc/apt/keyrings/aurora-build.gpg"
printf 'Types: deb\nURIs: %s\nSuites: aurora\nComponents: main\nSigned-By: /etc/apt/keyrings/aurora-build.gpg\n' \
  "$repository" > "$mountroot/etc/apt/sources.list.d/aurora-build.sources"
cp "$root/packages/aurora-archive-keyring/aurora.pref" "$mountroot/etc/apt/preferences.d/aurora.pref"
# Debian's default GRUB settings, which the image extends below; only the
# full grub-efi-arm64 package would install them, and it reinstalls GRUB on
# every update, which would undo the hardened core image.
packages=(aurora-archive-keyring linux-image-aurora aurora-userpages aurora-boot aurora-firstboot aurora-firmware
  aura uboot-aurora asahi-scripts grub-efi-arm64-bin grub2-common dracut cryptsetup-bin systemd-cryptsetup
  btrfs-progs python3 network-manager wpasupplicant bluez wireless-regdb firmware-linux aurora-sep fprintd libpam-fprintd
  avd-fw libva-v4l2-request upower mesa-vulkan-drivers libgl1-mesa-dri libegl-mesa0 mesa-aurora-fex-guest
  aurora-system-fixes aurora-logos aurora-audio alsa-utils alsa-ucm-conf-aurora aurora-bless
  aurora-nvram aurora-btsync aurora-panel-nits aurora-camera-denoise aurora-kbd-light aurora-wifi-firmware lzfse
  aurora-fido aurora-sep-sk tiny-dfr pipewire-pulse pipewire-alsa openssh-server openssh-client)
# alarm-aurora's linux-firmware includes the Realtek, MediaTek and Atheros
# firmware that USB network adapters (r8152, mt76, ath9k_htc) load; Debian's
# firmware-linux leaves them out.
packages+=(firmware-realtek firmware-mediatek firmware-atheros)
recommends=--no-install-recommends
# Desktops carry GameMode with Aurora's settings (aurora-gamemode), as on
# alarm-aurora; Debian's desktop metapackages bring their applications as
# recommendations. Plasma Login is the KDE display manager, so SDDM, which
# kde-plasma-desktop recommends, is refused (the trailing -).
case $desktop in
  kde) recommends=--install-recommends
    packages+=(kwin-wayland iio-sensor-proxy kde-plasma-desktop plasma-workspace-wallpapers kinfocenter
      plasma-login-manager konsole dolphin plasma-nm firefox xdg-desktop-portal-kde plasma-setup plymouth
      plymouth-theme-aurora gamemode aurora-gamemode sddm-);;
  gnome) recommends=--install-recommends
    packages+=(mutter gnome-settings-daemon iio-sensor-proxy gnome-core gnome-shell gdm3 gnome-control-center
      nautilus gnome-terminal gnome-keyring gvfs firefox xdg-desktop-portal-gnome gnome-initial-setup
      gnome-backgrounds plymouth plymouth-theme-aurora gamemode aurora-gamemode);;
esac
chroot "$mountroot" apt-get update
# aurora-flatpak-gl cannot yet be built inside sbuild (docs/parity/graphics.md);
# install it when the repository provides it.
if chroot "$mountroot" apt-cache show aurora-flatpak-gl >/dev/null 2>&1; then
  packages+=(aurora-flatpak-gl)
fi
attempt=1
until chroot "$mountroot" env DEBIAN_FRONTEND=noninteractive apt-get install -y "$recommends" "${packages[@]}"; do
  (( attempt++ < 3 ))
  sleep 30
done
# Aurora's builds replaced Debian's: the speaker stack, Mesa and the rest.
for package in alsa-ucm-conf-aurora aurora-audio linux-image-aurora; do
  chroot "$mountroot" dpkg-query -W "$package"
done
for package in alsa-ucm-conf-asahi asahi-audio sddm; do
  if chroot "$mountroot" dpkg-query -W -f '${Status}' "$package" 2>/dev/null | grep -q 'install ok installed'; then
    echo "$package is installed beside Aurora's stack" >&2; exit 1
  fi
done
# Every graphics package comes from the one Aurora Mesa build. Aurora's Mesa
# keeps Debian's binary package names, so the installed version must be the
# one Aurora's repository carries.
mesa_version=$(chroot "$mountroot" dpkg-query -W -f '${Version}' libgl1-mesa-dri)
chroot "$mountroot" apt-cache madison libgl1-mesa-dri |
  awk -F ' [|] ' -v version="$mesa_version" '$2 == version && $3 ~ / aurora\/main / { found = 1 } END { exit !found }'
for package in mesa-vulkan-drivers libegl-mesa0; do
  [[ $(chroot "$mountroot" dpkg-query -W -f '${Version}' "$package") == "$mesa_version" ]]
done
# The camera filter is on for every user, the keyboard backlight follows the
# light sensor and the Wi-Fi firmware follows the installed macOS: their
# packages enable them.
[[ -L $mountroot/etc/systemd/user/pipewire.service.wants/aurora-camera-denoise.service ]]
[[ -L $mountroot/etc/systemd/system/multi-user.target.wants/aurora-kbd-light.service ]]
[[ -L $mountroot/etc/systemd/system/multi-user.target.wants/aurora-wifi-firmware.service ]]
# The Touch ID security key is opt in: installed, never enabled by the image.
[[ ! -e $mountroot/etc/systemd/system/multi-user.target.wants/aurora-fido.service ]]
# speakerguardd v2 is opt in: the legacy protection keeps the speakers until the
# user runs aurora-speaker-upgrade, so the image never enables its boot unit.
[[ ! -e $mountroot/etc/systemd/system/multi-user.target.wants/aurora-speaker-upgrade.service ]]

# A UTF-8 default locale; first-boot setup may change the language afterwards.
sed -i 's/^# *\(en_US\.UTF-8 UTF-8\)/\1/' "$mountroot/etc/locale.gen"
grep -q '^en_US\.UTF-8 UTF-8' "$mountroot/etc/locale.gen"
chroot "$mountroot" locale-gen
printf 'LANG=en_US.UTF-8\n' > "$mountroot/etc/default/locale"
printf 'LANG=en_US.UTF-8\n' > "$mountroot/etc/locale.conf"
# The console keymap the initrd's password prompt uses; first boot follows the
# desktop layout from here (aurora-platform).
[[ -s $mountroot/etc/vconsole.conf ]] || printf 'KEYMAP=us\n' > "$mountroot/etc/vconsole.conf"

# Images carry no account, no machine identity and no host keys; mmdebstrap
# copies the build host's /etc/hostname, so it goes too (aurora-firstboot or
# the desktop's setup names the Mac). Debian has no wheel group;
# aurora-firstboot creates the owner in it.
chroot "$mountroot" groupadd --system wheel
chroot "$mountroot" usermod -L root
# The desktops' setups (Plasma's, and GNOME's through accountsservice) create
# the owner with useradd's default shell, which Debian sets to /bin/sh;
# aurora-firstboot gives the owner bash, so the desktops do too.
sed -i 's|^SHELL=/bin/sh$|SHELL=/bin/bash|' "$mountroot/etc/default/useradd"
grep -qx 'SHELL=/bin/bash' "$mountroot/etc/default/useradd"
rm -f "$mountroot/etc/ssh/"ssh_host_* "$mountroot/var/lib/systemd/random-seed" "$mountroot/etc/hostname"
printf 'uninitialized\n' > "$mountroot/etc/machine-id"
# Debian's ssh.service expects host keys; create them when the owner first
# enables remote login. A drop-in's ExecStartPre= runs after the unit's own,
# and Debian's `sshd -t` fails without host keys, so the list is replaced with
# key generation first. (sshd-keygen.service runs only on a first boot.)
install -d -m 0755 "$mountroot/etc/systemd/system/ssh.service.d"
printf '[Service]\nExecStartPre=\nExecStartPre=/usr/bin/ssh-keygen -A\nExecStartPre=/usr/sbin/sshd -t\n' \
  > "$mountroot/etc/systemd/system/ssh.service.d/10-aurora-host-keys.conf"

# An install's first boot applies every preset in enable-only mode. Apply
# them here in full, so the image already has what they enable and nothing
# that Debian's maintainer scripts enabled against them (aurora-boot's
# 81-aurora-image-enable.preset names the units the image keeps on). A full
# pass also drops /etc/systemd/system/default.target, which is set below.
chroot "$mountroot" systemctl preset-all --preset-mode=full
enable=(NetworkManager.service bluetooth.service aurora-peripherals.service systemd-resolved.service)
[[ ! -e $mountroot/usr/lib/systemd/system/aurora-fex-mesa.service ]] || enable+=(aurora-fex-mesa.service)
chroot "$mountroot" systemctl enable "${enable[@]}"
chroot "$mountroot" systemctl disable systemd-networkd.service systemd-networkd.socket \
  systemd-networkd-wait-online.service 2>/dev/null || true
# OpenSSH is installed for owners who want remote login; sshd stays off.
chroot "$mountroot" systemctl disable ssh.service ssh.socket 2>/dev/null || true
install -d -m 0755 "$mountroot/etc/NetworkManager/conf.d"
printf '[main]\ndns=systemd-resolved\n' > "$mountroot/etc/NetworkManager/conf.d/20-aurora-dns.conf"
ln -sfn /run/systemd/resolve/stub-resolv.conf "$mountroot/etc/resolv.conf"
case $desktop in
  # Plasma Login Manager: its greeter runs on KWin Wayland, so it is drawn at
  # the display's scale.
  kde) chroot "$mountroot" systemctl enable plasmalogin.service plasma-setup.service
    chroot "$mountroot" systemctl set-default graphical.target;;
  # gdm3's maintainer script links display-manager.service to the gdm3.service
  # alias. GDM starts through it, but systemd doesn't count gdm.service as
  # enabled, and enable keeps a link it resolves to the unit; disabling first
  # replaces it with gdm.service's own link.
  gnome) chroot "$mountroot" systemctl disable gdm.service
    chroot "$mountroot" systemctl enable gdm.service
    chroot "$mountroot" systemctl set-default graphical.target;;
  *) chroot "$mountroot" systemctl set-default multi-user.target;;
esac
if [[ $desktop == kde ]]; then
  # Plasma Setup writes its setup user's autologin for the display manager
  # whose unit is enabled; only Plasma Login may be the KDE display manager.
  [[ $(chroot "$mountroot" systemctl is-enabled plasmalogin.service) == enabled ]]
  [[ $(readlink "$mountroot/etc/systemd/system/display-manager.service") == */plasmalogin.service ]]
  # GDM quits the splash itself; Plasma Login does not. Give it GDM's role so
  # the splash lasts until the greeter on every boot.
  install -d -m 0755 "$mountroot/etc/systemd/system/plasmalogin.service.d"
  cat > "$mountroot/etc/systemd/system/plasmalogin.service.d/10-aurora-plymouth.conf" <<'EOF'
[Unit]
# The splash stays up until the greeter starts, as with GDM; if Plasma Login
# fails, plymouth-quit.service still removes it.
Conflicts=plymouth-quit.service
After=plymouth-start.service
OnFailure=plymouth-quit.service

[Service]
ExecStartPre=-/usr/bin/timeout --kill-after=2 20 /usr/bin/plymouth quit
EOF
fi
if [[ $desktop != minimal ]]; then
  # The Aurora theme draws aura's logo where aura left it, with the spinner
  # below; dracut adds Plymouth to the initrd where it is installed.
  chroot "$mountroot" plymouth-set-default-theme aurora
fi

root_uuid=$(blkid -s UUID -o value "${loop}p3")
boot_uuid=$(blkid -s UUID -o value "${loop}p2")
efi_uuid=$(blkid -s UUID -o value "${loop}p1")
printf 'UUID=%s / btrfs subvol=root,compress=zstd:1 0 0\nUUID=%s /home btrfs subvol=home,compress=zstd:1 0 0\nUUID=%s /boot ext4 defaults 0 2\nUUID=%s /boot/efi vfat umask=0077 0 2\n' "$root_uuid" "$root_uuid" "$boot_uuid" "$efi_uuid" > "$mountroot/etc/fstab"
[[ -f $mountroot/etc/default/grub ]] || cp "$mountroot/usr/share/grub/default/grub" "$mountroot/etc/default/grub"
# Debian's /etc/grub.d/10_linux adds rootflags=subvol=root itself for a root
# on a btrfs subvolume.
printf '\n' >> "$mountroot/etc/default/grub"
# Quiet by default; desktop images boot to the splash. The console is the
# display: a device tree's serial console would otherwise get Plymouth's
# prompts as text.
cmdline='quiet loglevel=3 rd.udev.log_level=3 systemd.show_status=auto console=tty0'
[[ $desktop == minimal ]] || cmdline+=' splash'
printf 'GRUB_CMDLINE_LINUX_DEFAULT="%s"\n' "$cmdline" >> "$mountroot/etc/default/grub"
kernels=("$mountroot"/usr/lib/modules/*)
(( ${#kernels[@]} == 1 ))
kernel=${kernels[0]##*/}
chroot "$mountroot" dracut --force "/boot/initrd.img-$kernel" "$kernel"
chroot "$mountroot" grub-install --target=arm64-efi --efi-directory=/boot/efi --removable --no-nvram
chroot "$mountroot" update-grub
# aurora-userpages' GRUB drop-in turns per-process 4K userspace pages on.
grep -Eq '^\s*linux\s.*\suser4k=on(\s|$)' "$mountroot/boot/grub/grub.cfg"
mkdir -p "$mountroot/boot/efi/m1n1"
# In the C locale t6040-j616s-tether.dtb sorts before t6040-j616s.dtb, and aura
# boots the last tree of a board, so the board's main tree has to come last.
LC_ALL=C chroot "$mountroot" update-m1n1 /boot/efi/m1n1/boot.bin
monitor_free=false
if [[ -e $mountroot/usr/share/aura/monitor-free ]]; then monitor_free=true; fi

# Built from the pinned snapshot; the installed system follows live Debian
# testing and the Aurora channel it was built for.
rm -f "$mountroot/etc/apt/sources.list.d/aurora-build.sources" "$mountroot/etc/apt/keyrings/aurora-build.gpg"
rm -f "$mountroot/etc/apt/sources.list"
printf 'Types: deb\nURIs: %s\nSuites: %s %s-updates\nComponents: %s\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: https://security.debian.org/debian-security\nSuites: %s-security\nComponents: %s\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
  "$live_mirror" "$suite" "$suite" "$components" "$suite" "$components" > "$mountroot/etc/apt/sources.list.d/debian.sources"
printf 'Types: deb\nURIs: https://aurorasilicon.org/debian-aurora/%s\nSuites: aurora\nComponents: main\nSigned-By: /usr/share/keyrings/aurora-archive-keyring.gpg\n' \
  "$channel" > "$mountroot/etc/apt/sources.list.d/aurora.sources"
chroot "$mountroot" apt-get clean
rm -rf "$mountroot"/var/lib/apt/lists/*
# The first boot must find nothing left to change. A unit the image keeps off
# although a preset enables it needs a line in aurora-boot's 80-aurora-image.preset.
presets=$(chroot "$mountroot" systemctl preset-all --preset-mode=enable-only 2>&1) || { printf '%s\n' "$presets" >&2; exit 1; }
if grep -E '^(Created symlink|Removed) ' <<<"$presets" >&2; then
  echo 'Units differ from their presets; the first boot would change them' >&2
  exit 1
fi
# Nor may a unit be on against its preset: one the image keeps on needs a line
# in 81-aurora-image-enable.preset. (finalize-image checks the same.)
against=$(chroot "$mountroot" systemctl list-unit-files --no-legend --no-pager |
  awk '($2 == "enabled" && $3 == "disabled") || ($2 == "disabled" && $3 == "enabled")')
if [[ -n $against ]]; then
  printf '%s\n' "$against" >&2
  echo 'Units are enabled or disabled against their presets' >&2
  exit 1
fi
# Every image ships the basics; a build that lacks one fails here instead of
# on a Mac.
python3 "$root/scripts/check-basics.py" --profile "$desktop" --root "$mountroot"
for path in dev proc sys run boot/efi boot ''; do
  if mountpoint -q "$mountroot${path:+/$path}"; then umount -R "$mountroot${path:+/$path}"; fi
done
losetup -d "$loop"; loop=''

# The shared finalizer, from the pinned aurora-platform source (or a local
# checkout while its Debian support is not in the pin: AURORA_PLATFORM_SOURCE).
finalizer=${AURORA_PLATFORM_SOURCE:-}
if [[ -z $finalizer ]]; then
  python3 - "$root" <<'PY'
import json, sys, tarfile
from pathlib import Path
root = Path(sys.argv[1]); sys.path.insert(0, str(root / 'scripts'))
import recipe
pin = json.loads((root / 'sources.json').read_text())['aurora-firstboot']
url, digest = recipe.pinned({'pin': 'aurora-firstboot'}, {'aurora-firstboot': pin})
archive = recipe.download(url, digest, root / 'cache/sources')
with tarfile.open(archive) as tar:
    tar.extractall(root / 'out/finalizer', filter='data')
PY
  finalizer=$(echo "$root"/out/finalizer/aurora-platform-*)
fi
bash "$finalizer/images/finalize-image" "$image" "$profile" "$root/out/$profile-installer"
# aurora-initrd-root needs util-linux's lsblk (and a full awk) in the initrd:
# no busybox applet may stand in for them.
if grep -q -- ' -> busybox$' "$root/out/$profile-installer/initramfs-inventory.txt"; then
  echo "the initrd contains busybox applets" >&2; exit 1
fi
# A Stage 1 with the CTXR window chainloads these, on Mach-O Macs.
if $monitor_free; then
  python3 "$root/scripts/prepare-ctxr-stage2.py" "$root/out/$profile-installer/esp/m1n1"
fi
# GRUB finds /boot by UUID on the startup disk only, in the files the
# installer writes.
python3 "$root/scripts/check-basics.py" --profile "$desktop" --esp "$root/out/$profile-installer/esp" \
  --boot-image "$root/out/$profile-installer/boot.img" --boot-uuid "$boot_uuid"
tar --sparse -C "$root/out/$profile-installer" -cf - . | zstd -T4 -3 -o "$root/out/$profile-filesystems.tar.zst"
sha256sum "$root/out/$profile-filesystems.tar.zst" > "$root/out/$profile-filesystems.tar.zst.sha256"
