#!/usr/bin/make -f
# alarm-aurora's omarchy-ane-tools recipe: the runner with libane linked
# statically, the smoke and firmware scripts, and the two add fixtures.
PKG := debian/omarchy-ane-tools

%:
	dh $@

override_dh_auto_build:
	$(MAKE) -C libane libane
	$(MAKE) -C tools ane-run

# Host only, no device or network. tools/test_ane_smoke.py is left out, as in
# alarm-aurora: it times fake ANE calls against a 2 s limit.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	python3 tools/test_ane_firmware_fetch.py
endif

override_dh_auto_install:
	install -Dm644 debian/70-omarchy-ane.rules $(PKG)/usr/lib/udev/rules.d/70-omarchy-ane.rules
	install -Dm755 tools/ane-run $(PKG)/usr/bin/omarchy-ane-run
	install -Dm755 -t $(PKG)/usr/bin packaging/omarchy-ane-smoke packaging/omarchy-ane-firmware-fetch
	# omarchy-ane-smoke looks for its programs here.
	set -e; for gen in h13 h14; do \
	  install -Dm644 fixtures/$$gen-anec/add/program-0.anec \
	    $(PKG)/usr/share/omarchy-ane/fixtures/$$gen-anec/add/program-0.anec; \
	done

override_dh_auto_clean:
	$(MAKE) -C libane clean
	$(MAKE) -C tools clean
