#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_install:
	dh_auto_install -- PREFIX=/usr UNITDIR=/usr/lib/systemd/system

# Enabled as alarm-aurora's preset enables it. As there, installing does not
# start it (it starts at boot or from the udev rule); an upgrade restarts it
# when it runs.
override_dh_installsystemd:
	dh_installsystemd --no-start --restart-after-upgrade

override_dh_installudev:
	dh_installudev --priority=90
