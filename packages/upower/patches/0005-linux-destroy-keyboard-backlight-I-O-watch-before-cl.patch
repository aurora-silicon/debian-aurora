From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Guilhem Lettron <guilhem@barpilot.io>
Date: Fri, 30 Oct 2026 17:14:18 +0100
Subject: [PATCH] linux: destroy keyboard backlight I/O watch before closing
 its fd

Remove the brightness_hw_changed watch before finalization closes its fd
or frees the callback data, avoiding a POLLNVAL busy loop or stale callback.
Handle HUP/NVAL before PRI and clear the watch ID when the callback removes
itself. Add regression coverage for watch lifetime and poll conditions.

Assisted-by: OpenAI Codex
Signed-off-by: Guilhem Lettron <guilhem@barpilot.io>
(cherry picked from commit c2e6e11096ab3ed78367efc0d6d4f6e46e5ae9be)
---
 src/linux/tests/up-kbd-backlight-led-test.c | 183 ++++++++++++++++++++
 src/linux/up-kbd-backlight-led.c            |  28 +--
 src/meson.build                             |  11 ++
 3 files changed, 212 insertions(+), 10 deletions(-)
 create mode 100644 src/linux/tests/up-kbd-backlight-led-test.c

diff --git a/src/linux/tests/up-kbd-backlight-led-test.c b/src/linux/tests/up-kbd-backlight-led-test.c
new file mode 100644
index 00000000..c6354186
--- /dev/null
+++ b/src/linux/tests/up-kbd-backlight-led-test.c
@@ -0,0 +1,183 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "config.h"
+
+#include <gio/gio.h>
+#include <glib/gstdio.h>
+
+#include "linux/up-kbd-backlight-led.h"
+#include "up-native.h"
+
+static GIOCondition poll_condition;
+
+typedef struct {
+	const gchar *path;
+	gboolean has_watch;
+	gint condition; /* -1 skips dispatch before finalization. */
+	gboolean watch_remains;
+} WatchTest;
+
+/**
+ * poll_watch:
+ *
+ * Simulate sysfs priority and terminal events without hardware.
+ **/
+static gint
+poll_watch (GPollFD *fds, guint n_fds, gint timeout)
+{
+	gint ready = 0;
+
+	for (guint i = 0; i < n_fds; i++) {
+		fds[i].revents = (fds[i].events & G_IO_PRI) ? poll_condition : 0;
+		ready += fds[i].revents != 0;
+	}
+
+	return ready;
+}
+
+/**
+ * up_native_get_native_path:
+ * @object: the test's native tracking object
+ *
+ * Supply the fixture's filesystem path without requiring a udev device or
+ * restricting the temporary directory to valid D-Bus object path characters.
+ **/
+const gchar *
+up_native_get_native_path (GObject *object)
+{
+	return g_object_get_data (object, "native-path");
+}
+
+/**
+ * get_poll_count:
+ *
+ * Count registered poll descriptors, even when none is ready.
+ **/
+static gint
+get_poll_count (GMainContext *context)
+{
+	gint priority;
+	gint timeout;
+	gint count;
+
+	g_assert_true (g_main_context_acquire (context));
+	g_main_context_prepare (context, &priority);
+	count = g_main_context_query (context, priority, &timeout, NULL, 0);
+	g_main_context_release (context);
+
+	return count;
+}
+
+/**
+ * write_attribute:
+ *
+ * Create a simulated LED attribute in a temporary directory.
+ **/
+static void
+write_attribute (const gchar *directory, const gchar *name, const gchar *value)
+{
+	g_autofree gchar *path = g_build_filename (directory, name, NULL);
+	g_autoptr (GError) error = NULL;
+
+	g_assert_true (g_file_set_contents (path, value, -1, &error));
+	g_assert_no_error (error);
+}
+
+/**
+ * remove_attribute:
+ *
+ * Remove a simulated LED attribute after the device has been destroyed.
+ **/
+static void
+remove_attribute (const gchar *directory, const gchar *name)
+{
+	g_autofree gchar *path = g_build_filename (directory, name, NULL);
+
+	g_assert_cmpint (g_remove (path), ==, 0);
+}
+
+/**
+ * up_test_kbd_backlight_watch_cleanup:
+ *
+ * Exercise the LED coldplug and finalize methods without exporting D-Bus.
+ **/
+static void
+up_test_kbd_backlight_watch_cleanup (gconstpointer data)
+{
+	const WatchTest *test = data;
+	GMainContext *context = g_main_context_default ();
+	g_autoptr (GError) error = NULL;
+	g_autofree gchar *directory = g_dir_make_tmp ("upower_kbd_backlight_XXXXXX", &error);
+	g_autoptr (GObject) native = NULL;
+	g_autoptr (UpDeviceKbdBacklight) device = NULL;
+	gpointer weak_device;
+	gint original_poll_count;
+
+	g_assert_no_error (error);
+	write_attribute (directory, "max_brightness", "100");
+	write_attribute (directory, "brightness", "50");
+	if (test->has_watch)
+		write_attribute (directory, "brightness_hw_changed", "75");
+
+	native = g_object_new (G_TYPE_OBJECT, NULL);
+	g_object_set_data_full (native, "native-path", g_strdup (directory), g_free);
+	device = g_object_new (UP_TYPE_KBD_BACKLIGHT_LED, "native", native, NULL);
+	original_poll_count = get_poll_count (context);
+	g_assert_true (UP_DEVICE_KBD_BACKLIGHT_GET_CLASS (device)->coldplug (device));
+	g_assert_cmpint (get_poll_count (context), ==, original_poll_count + test->has_watch);
+
+	if (test->condition >= 0) {
+		GSource *source = g_main_context_find_source_by_user_data (context, device);
+		GPollFunc original_poll = g_main_context_get_poll_func (context);
+		gboolean dispatched;
+		gint brightness;
+
+		g_assert_nonnull (source);
+		poll_condition = test->condition;
+		g_main_context_set_poll_func (context, poll_watch);
+		if (poll_condition == 0)
+			g_source_set_ready_time (source, 0);
+		dispatched = g_main_context_iteration (context, FALSE);
+		g_main_context_set_poll_func (context, original_poll);
+		g_assert_true (dispatched);
+		g_assert_cmpint (get_poll_count (context), ==,
+				 original_poll_count + test->watch_remains);
+		g_object_get (device, "brightness", &brightness, NULL);
+		g_assert_cmpint (brightness, ==, test->watch_remains ? 75 : 50);
+	}
+
+	weak_device = device;
+	g_object_add_weak_pointer (G_OBJECT (device), &weak_device);
+	g_clear_object (&device);
+	g_assert_null (weak_device);
+	/* A closed fd left in the poll set would keep waking the main loop. */
+	g_assert_cmpint (get_poll_count (context), ==, original_poll_count);
+
+	if (test->has_watch)
+		remove_attribute (directory, "brightness_hw_changed");
+	remove_attribute (directory, "brightness");
+	remove_attribute (directory, "max_brightness");
+	g_assert_cmpint (g_rmdir (directory), ==, 0);
+}
+
+int
+main (int argc, char **argv)
+{
+	static const WatchTest tests[] = {
+		{ "/kbd-backlight/finalize-with-watch", TRUE, -1, TRUE },
+		{ "/kbd-backlight/finalize-without-watch", FALSE, -1, FALSE },
+		{ "/kbd-backlight/finalize-after-watch-removed", TRUE, 0, FALSE },
+		{ "/kbd-backlight/hangup", TRUE, G_IO_HUP, FALSE },
+		{ "/kbd-backlight/invalid-fd", TRUE, G_IO_NVAL, FALSE },
+		{ "/kbd-backlight/hangup-with-priority", TRUE, G_IO_HUP | G_IO_PRI, FALSE },
+		{ "/kbd-backlight/invalid-fd-with-priority", TRUE, G_IO_NVAL | G_IO_PRI, FALSE },
+		{ "/kbd-backlight/priority", TRUE, G_IO_PRI, TRUE },
+		{ "/kbd-backlight/priority-with-error", TRUE, G_IO_PRI | G_IO_ERR, TRUE },
+	};
+
+	g_test_init (&argc, &argv, NULL);
+	for (guint i = 0; i < G_N_ELEMENTS (tests); i++)
+		g_test_add_data_func (tests[i].path, &tests[i], up_test_kbd_backlight_watch_cleanup);
+
+	return g_test_run ();
+}
diff --git a/src/linux/up-kbd-backlight-led.c b/src/linux/up-kbd-backlight-led.c
index cff67f53..fc1eedb0 100644
--- a/src/linux/up-kbd-backlight-led.c
+++ b/src/linux/up-kbd-backlight-led.c
@@ -45,6 +45,7 @@ struct UpKbdBacklightLedPrivate
 
 	gint			 fd_hw_changed;
 	GIOChannel		*channel_hw_changed;
+	guint			 watch_id;
 };
 
 G_DEFINE_TYPE_WITH_PRIVATE (UpKbdBacklightLed, up_kbd_backlight_led, UP_TYPE_DEVICE_KBD_BACKLIGHT)
@@ -187,10 +188,10 @@ up_kbd_backlight_led_event_io (GIOChannel *channel, GIOCondition condition, gpoi
 	gchar *end = NULL;
 
 	if (priv->fd_hw_changed < 0)
-		return FALSE;
+		goto remove_watch;
 
-	if (!(condition & G_IO_PRI))
-		return FALSE;
+	if ((condition & (G_IO_HUP | G_IO_NVAL)) || !(condition & G_IO_PRI))
+		goto remove_watch;
 
 	lseek (priv->fd_hw_changed, 0, SEEK_SET);
 
@@ -199,13 +200,13 @@ up_kbd_backlight_led_event_io (GIOChannel *channel, GIOCondition condition, gpoi
 	errsv = errno;
 
 	if (len == 0) {
-		return TRUE;
+		return G_SOURCE_CONTINUE;
 	} else if (len < 0) {
 		if (errsv == EINTR || errsv == ENODATA) {
-			return TRUE;
+			return G_SOURCE_CONTINUE;
 		} else {
 			g_warning ("kbd eventio: failed to read brightness. %s", g_strerror (errsv));
-			return FALSE;
+			goto remove_watch;
 		}
 	} else {
 		buf[len] = '\0';
@@ -222,12 +223,16 @@ up_kbd_backlight_led_event_io (GIOChannel *channel, GIOCondition condition, gpoi
 	g_debug ("kbd eventio: brightness: %d", brightness);
 
 	if (brightness < 0)
-		return FALSE;
+		goto remove_watch;
 
 	up_device_kbd_backlight_emit_change (kbd_backlight, brightness, "internal");
 	up_device_kbd_backlight_report (kbd_backlight, priv->max_brightness, brightness, TRUE);
 
-	return TRUE;
+	return G_SOURCE_CONTINUE;
+
+remove_watch:
+	priv->watch_id = 0;
+	return G_SOURCE_REMOVE;
 }
 
 /**
@@ -270,8 +275,9 @@ up_kbd_backlight_led_coldplug (UpDeviceKbdBacklight *kbd_backlight)
 	priv->fd_hw_changed = g_open (path_hw_changed, O_RDONLY);
 	if (priv->fd_hw_changed >= 0) {
 		priv->channel_hw_changed = g_io_channel_unix_new (priv->fd_hw_changed);
-		g_io_add_watch (priv->channel_hw_changed,
-				G_IO_PRI, up_kbd_backlight_led_event_io, kbd_backlight);
+		priv->watch_id = g_io_add_watch (priv->channel_hw_changed,
+						 G_IO_PRI | G_IO_HUP | G_IO_NVAL,
+						 up_kbd_backlight_led_event_io, kbd_backlight);
 	}
 
 	up_device_kbd_backlight_report (kbd_backlight, priv->max_brightness, priv->brightness, FALSE);
@@ -295,6 +301,8 @@ up_kbd_backlight_led_finalize (GObject *object)
 	kbd_backlight = UP_KBD_BACKLIGHT_LED (object);
 	priv = up_kbd_backlight_led_get_instance_private (kbd_backlight);
 
+	g_clear_handle_id (&priv->watch_id, g_source_remove);
+
 	if (priv->channel_hw_changed) {
 		g_io_channel_shutdown (priv->channel_hw_changed, FALSE, NULL);
 		g_io_channel_unref (priv->channel_hw_changed);
diff --git a/src/meson.build b/src/meson.build
index f97fd3d6..3dfaa3ff 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -121,6 +121,17 @@ test(
    up_self_test,
 )
 
+if os_backend == 'linux'
+    up_kbd_backlight_led_test = executable('up_kbd_backlight_led_test',
+        sources: [ 'linux/tests/up-kbd-backlight-led-test.c' ],
+        dependencies: upowerd_deps,
+        link_with: [ upowerd_private, upshared['linux'] ],
+        gnu_symbol_visibility: 'hidden',
+        install: false,
+    )
+    test('kbd-backlight-watch', up_kbd_backlight_led_test)
+endif
+
 # On Linux, we can run the additional integration test;
 # defined here as we would have a circular dependency otherwise.
 if os_backend == 'linux' and gobject_introspection.found()
