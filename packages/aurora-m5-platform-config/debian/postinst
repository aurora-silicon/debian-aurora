#!/bin/sh
set -e

#DEBHELPER#

# As alarm-aurora's install script: on a running J714s the sleep policy
# applies from the next suspend, the lid setting from the next boot. The
# unit's condition skips every other Mac. deb-systemd-invoke does not start a
# static unit, so start it here, once, on a first installation.
if [ "$1" = configure ] && [ -z "$2" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
	systemctl start aurora-m5-sleep-policy.service >/dev/null 2>&1 || :
fi

exit 0
