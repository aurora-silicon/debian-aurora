#!/bin/sh
set -e

#DEBHELPER#

# The sep-key group (created above from sysusers.d) owns /dev/sep-key: let
# udev apply the rule to a device that is already there.
if [ "$1" = configure ] && [ -z "$DPKG_ROOT" ] && [ -d /run/udev ]; then
	udevadm control --reload-rules >/dev/null 2>&1 || true
	udevadm trigger --subsystem-match=misc --sysname-match=sep-key >/dev/null 2>&1 || true
fi
