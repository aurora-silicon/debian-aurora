#!/bin/sh
set -e

version=@RELEASE@
image=/boot/vmlinuz-$version

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    if [ -d /etc/kernel/preinst.d ]; then
        DEB_MAINT_PARAMS="$*" run-parts --report --exit-on-error --arg="$version" --arg="$image" \
            /etc/kernel/preinst.d
    fi
fi

#DEBHELPER#

exit 0
